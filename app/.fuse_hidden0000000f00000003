@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --font-display: "Fraunces", serif;
  --font-sans: "Inter", system-ui, sans-serif;

  /* Single premium easing curve, shared by every CSS transition below so
     hover/press feedback reads identically across the whole site. Fast
     departure, soft settle — the same shape framer-motion uses for its
     enter animations. */
  --ease-premium: cubic-bezier(0.22, 1, 0.36, 1);
}

html {
  /* Native smooth-scroll stays off: Lenis owns wheel scrolling on desktop
     and anchor jumps are handled programmatically. */
  scroll-behavior: auto;
  /* Stops iOS Safari inflating font sizes in landscape. */
  -webkit-text-size-adjust: 100%;
}

body {
  background: #f8fafc;
  color: #1f2937;
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  /* `clip` instead of `hidden`: both prevent horizontal scroll, but `hidden`
     makes the body a scroll container, which silently breaks `position:
     sticky` on descendants and forces the browser to keep an extra scroll
     box in sync. `clip` has neither cost. */
  overflow-x: clip;
}

/* Removes the ~300ms synthetic click delay and the grey flash on tap, which
   is most of what makes a mobile site feel unresponsive to touch. */
a,
button,
[role="button"],
input,
select,
textarea,
summary {
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}

/* Keyboard users must keep a visible focus ring even though tap highlight
   is suppressed above. */
:focus-visible {
  outline: 2px solid #2447e6;
  outline-offset: 2px;
}

::selection {
  background: #38bdf8;
  color: #0a1233;
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 10px;
}
::-webkit-scrollbar-track {
  background: #f8fafc;
}
::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, #1e40af, #38bdf8);
  border-radius: 999px;
}

@layer components {
  /* Fixed, always-on-screen navbar background. backdrop-filter here forces
     the browser to recomposite a blur every scroll frame since the header
     never moves — the single biggest cause of mobile scroll jank in this
     layout. Below the sm breakpoint we drop the blur and compensate with a
     slightly more opaque fill so it reads the same to the eye. */
  .nav-glass {
    @apply bg-white/[0.98] sm:bg-white/95;
  }
  @media (min-width: 640px) {
    .nav-glass {
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
  }

  /* `.glass` removed — it was only ever used by the two hero floating badges,
     which are gone. It carried `backdrop-blur-xl`, the most expensive filter
     in the stylesheet. */
  .container-px {
    @apply px-6 sm:px-8 lg:px-12;
  }
  .section-py {
    @apply py-20 sm:py-28;
  }
  .eyebrow {
    @apply inline-flex items-center gap-2 rounded-full border border-royal-200 bg-royal-50 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-royal-700;
  }

  /* Buttons transition only compositor-friendly properties. `transition-all`
     was previously making the browser watch every animatable property on
     these elements for changes on each frame. */
  .btn-primary {
    @apply inline-flex items-center justify-center gap-2 rounded-full bg-royal-gradient px-7 py-3.5 text-sm font-semibold text-white shadow-premium;
    transition: transform 180ms var(--ease-premium);
  }
  .btn-primary:hover {
    transform: scale(1.03);
  }
  .btn-primary:active {
    transform: scale(0.98);
  }

  .btn-secondary {
    @apply inline-flex items-center justify-center gap-2 rounded-full border border-ink/15 bg-white px-7 py-3.5 text-sm font-semibold text-ink hover:border-royal-700 hover:text-royal-700;
    transition: color 180ms var(--ease-premium), border-color 180ms var(--ease-premium);
  }

  .btn-ghost-light {
    @apply inline-flex items-center justify-center gap-2 rounded-full border border-white/30 bg-white/10 px-7 py-3.5 text-sm font-semibold text-white hover:bg-white/20;
    transition: background-color 180ms var(--ease-premium);
  }

  /* No transition at all. Transform is excluded because framer-motion's
     `whileHover` writes transform inline every frame, and a CSS transition on
     the same property makes the browser re-interpolate each of those writes
     over its own duration — the two fight and produce a laggy, floaty hover.
     Shadow and border-color are excluded because an audit found that not one
     of the nine `.card-premium` call sites ever changes either on hover, so
     the transition never fired — it only cost the style engine work watching
     for a change that never came. */
  .card-premium {
    @apply rounded-3xl border border-black/5 bg-white shadow-glass;
  }

  /* Hover elevation without animating box-shadow.
     Interpolating a shadow means re-painting the blurred spread on every
     frame. Instead the stronger shadow is painted once onto a pseudo-element
     and cross-faded with `opacity`, which the compositor handles for free. */
  .shadow-hover-premium {
    position: relative;
  }
  .shadow-hover-premium::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 20px 60px -15px rgba(10, 18, 51, 0.25);
    opacity: 0;
    transition: opacity 220ms var(--ease-premium);
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .shadow-hover-premium:hover::after {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shadow-hover-premium::after {
      transition: none;
    }
  }

  .heading-display {
    @apply font-display font-medium tracking-tight text-navy;
  }
}

.mesh-bg {
  background-color: #f8fafc;
  background-image: radial-gradient(at 20% 20%, rgba(56,189,248,0.14) 0px, transparent 50%), radial-gradient(at 80% 0%, rgba(30,64,175,0.18) 0px, transparent 50%), radial-gradient(at 50% 100%, rgba(10,18,51,0.10) 0px, transparent 50%);
}

/* Gradient headline fill. The `shimmer` keyframe this used to reference was
   never emitted by Tailwind (no `animate-shimmer` utility appears in any
   component), so the animation never ran and the text has always rendered
   as a static gradient. Kept static deliberately: an infinite
   background-position animation on the LCP heading repaints the text layer
   every frame for the entire session. */
.shimmer-text {
  background: linear-gradient(90deg, #ffffff 0%, #7dd3fc 50%, #ffffff 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;

  /* DESCENDER CLIPPING — the second half of the broken-heading bug.
     `background-clip: text` paints the gradient only inside the element's
     background box and then clips it to the glyph shapes. The box is the line
     box, and the h1 runs `leading-[1.08]` — tighter than the font's own glyph
     extent. Anything reaching past it (Fraunces' descending `f`, the tail of
     the comma) falls outside the painted area, receives no gradient at all,
     and renders transparent. The letter looks sliced off.

     Extending the box and pulling the identical amount back off the margin
     fixes the clip while the element's outer size, and therefore the layout,
     stays byte-for-byte identical. */
  padding-block: 0.06em 0.2em;
  margin-block: -0.06em -0.2em;
}

/* Typographic hygiene for display headings.
   `font-synthesis: none` is the important one: it forbids the browser from
   faking a weight it does not have by smearing the nearest one. With the
   variable Fraunces now covering 100-900 nothing needs faking, so this is a
   guard against the bug ever returning if a weight is dropped later. */
h1,
h2,
h3,
.heading-display {
  font-kerning: normal;
  font-synthesis: none;
  font-variant-ligatures: no-discretionary-ligatures;
  font-optical-sizing: auto;
}

/* ---------------------------------------------------------------------------
   Hero logo idle float — the only continuous animation on the site.

   It runs on the logo itself rather than on the whole showcase card. The card
   is 384x496 CSS px; the logo is 200x221. Compositing the smaller of the two
   every frame is ~4.3x less pixel area for the GPU to move, for motion the eye
   reads as more deliberate because it is attached to the focal object.

   `translate3d` keeps the animation on the compositor thread: no layout, no
   paint, no main-thread work per frame. `will-change: transform` is declared
   here (rather than toggled from JS) because this animation is infinite — the
   element is always animating, so the hint is always accurate. It is released
   again under reduced-motion below, where no layer is needed.

   TRAVEL DISTANCE — the one number to tune here.

   This ran at 3px initially, which is ~1.1px per second over the cycle. That
   is below the speed at which the eye registers drift, so it read as
   completely static. 12px is gentle but unmistakably alive.

   Worth knowing before dialling it back down: distance has NO bearing on
   cost. Moving an element 3px or 30px is the same single compositor
   operation on the same already-promoted layer — identical GPU work,
   identical frame budget. Amplitude is purely an aesthetic choice.
--------------------------------------------------------------------------- */
@keyframes logo-float {
  0%,
  100% {
    transform: translate3d(0, 0, 0);
  }
  50% {
    transform: translate3d(0, -12px, 0);
  }
}

/* Coarse pointers (tablets in landscape still reach the lg breakpoint) get
   half the travel — subtler motion suits a hand-held screen. Declared as a
   second keyframe set rather than a custom property inside the first: an
   unregistered custom property in a keyframe value is substituted at computed
   -value time and interpolates unreliably in older Safari. */
@keyframes logo-float-subtle {
  0%,
  100% {
    transform: translate3d(0, 0, 0);
  }
  50% {
    transform: translate3d(0, -6px, 0);
  }
}

.logo-float {
  animation: logo-float 5s ease-in-out infinite;
  will-change: transform;
}

@media (pointer: coarse) {
  .logo-float {
    animation-name: logo-float-subtle;
  }
}

@media (prefers-reduced-motion: reduce) {
  .logo-float {
    animation: none;
    transform: none;
    will-change: auto;
  }
}

/* ---------------------------------------------------------------------------
   Hero logo ambient glow.

   A single painted radial gradient whose `opacity` breathes. Nothing is
   blurred and no shadow is interpolated: the gradient is rasterised once when
   the layer is created, and every frame after that is the compositor changing
   one alpha value on an existing texture. That is the cheapest continuous
   effect available in a browser — it costs the same whether the glow is 100px
   or 1000px across.

   The colour stops are the requested ramp (0.35 / 0.18 / 0.08 -> transparent)
   divided through by 0.35, so the peak stop sits at alpha 1.0 and the element's
   own opacity carries the real intensity. That is what lets the keyframes below
   read as literal 20% and 35% — the numbers from the brief — instead of being
   multiplied by a second alpha hidden in the gradient.

   #2563EB is within a couple of points of the palette's royal-600 (#2447E6),
   so it reads as the brand blue rather than a separate accent.
--------------------------------------------------------------------------- */
@keyframes logo-glow-breathe {
  0%,
  100% {
    opacity: 0.2;
  }
  50% {
    opacity: 0.35;
  }
}

.logo-glow {
  background: radial-gradient(
    circle,
    rgba(56, 189, 248, 0.9) 0%,
    rgba(37, 99, 235, 0.55) 35%,
    rgba(37, 99, 235, 0.22) 60%,
    transparent 78%
  );
  opacity: 0.22;
  animation: logo-glow-breathe 5.5s ease-in-out infinite;
  will-change: opacity;
}

@media (prefers-reduced-motion: reduce) {
  .logo-glow {
    animation: none;
    /* Midpoint of the breathing range — the glow stays, it just stops moving. */
    opacity: 0.32;
    will-change: auto;
  }
}

/* ---------------------------------------------------------------------------
   Shape-tracing halo.

   The radial pool above lights the area behind the mark; this lights the mark
   itself. `drop-shadow` reads the image's alpha channel, so the glow follows
   the crescent and the tower edges exactly rather than sitting behind them as
   a generic disc — that silhouette-hugging quality is the whole character of
   the reference.

   Three stacked shadows give a tight bright core falling off into a wide
   ambient wash. The filter is STATIC: it is rasterised once when the layer is
   built and never re-evaluated. Only `opacity` animates, which the compositor
   applies to the finished texture — so this never costs a per-frame blur.

   It is applied to a duplicate of the logo sitting behind the real one. The
   visible copy stays completely filter-free, because a filter forces an
   offscreen rasterise-and-composite pass, and that is what was softening the
   artwork before.
--------------------------------------------------------------------------- */
@keyframes logo-halo-breathe {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 0.95;
  }
}

.logo-halo {
  filter: drop-shadow(0 0 5px rgba(56, 189, 248, 0.95))
    drop-shadow(0 0 16px rgba(56, 189, 248, 0.6))
    drop-shadow(0 0 40px rgba(37, 99, 235, 0.55));
  opacity: 0.55;
  animation: logo-halo-breathe 5.5s ease-in-out infinite;
  will-change: opacity;
}

@media (prefers-reduced-motion: reduce) {
  .logo-halo {
    animation: none;
    opacity: 0.75;
    will-change: auto;
  }
}

/* ---------------------------------------------------------------------------
   Starfield.

   Static texture, not a particle system: one painted background of hairline
   radial gradients, rasterised once with the card and never touched again.
   No JS, no elements, no per-frame work. Kept faint so it reads as depth
   rather than decoration.
--------------------------------------------------------------------------- */
.hero-starfield {
  background-image: radial-gradient(1px 1px at 12% 16%, rgba(255, 255, 255, 0.55), transparent),
    radial-gradient(1px 1px at 27% 9%, rgba(186, 230, 253, 0.45), transparent),
    radial-gradient(1px 1px at 41% 22%, rgba(255, 255, 255, 0.35), transparent),
    radial-gradient(1.5px 1.5px at 68% 12%, rgba(255, 255, 255, 0.5), transparent),
    radial-gradient(1px 1px at 84% 21%, rgba(186, 230, 253, 0.4), transparent),
    radial-gradient(1px 1px at 8% 43%, rgba(255, 255, 255, 0.4), transparent),
    radial-gradient(1px 1px at 92% 47%, rgba(255, 255, 255, 0.3), transparent),
    radial-gradient(1.5px 1.5px at 18% 63%, rgba(186, 230, 253, 0.45), transparent),
    radial-gradient(1px 1px at 33% 78%, rgba(255, 255, 255, 0.35), transparent),
    radial-gradient(1px 1px at 55% 88%, rgba(255, 255, 255, 0.45), transparent),
    radial-gradient(1px 1px at 74% 71%, rgba(186, 230, 253, 0.4), transparent),
    radial-gradient(1.5px 1.5px at 88% 83%, rgba(255, 255, 255, 0.35), transparent),
    radial-gradient(1px 1px at 47% 38%, rgba(255, 255, 255, 0.25), transparent),
    radial-gradient(1px 1px at 62% 55%, rgba(186, 230, 253, 0.3), transparent);
}

/* ---------------------------------------------------------------------------
   Reveal + entrance animations, in CSS.

   These replace framer-motion on the critical path. framer was being pulled
   into the initial bundle by the root layout (navbar, scroll bar, floating
   buttons, motion config) and by Hero/About/Services — roughly 50KB gzipped
   that a phone had to download, parse and execute before it could respond to
   a tap. Every one of those animations was a one-shot reveal, a hover lift or
   a progress bar: all of it expressible in ~40 lines of CSS with no runtime.

   framer still handles the below-the-fold sections, where genuinely stateful
   work happens (AnimatePresence, shared-element `layoutId` pill highlights) —
   but it now loads in their lazy chunk instead of blocking first paint.
--------------------------------------------------------------------------- */

/* Scroll-triggered. Starts offset + transparent; `.is-visible` is added once
   by a single shared IntersectionObserver, which then stops observing. */
.reveal {
  opacity: 0;
  transform: translate3d(var(--rv-x, 0), var(--rv-y, 16px), 0);
  transition: opacity 240ms var(--ease-premium), transform 240ms var(--ease-premium);
}
.reveal.is-visible {
  opacity: 1;
  transform: translate3d(0, 0, 0);
}

/* Above-the-fold entrance. No observer needed — these are on screen at load,
   so they animate straight away.

   Fill mode is `backwards`, NOT `both`, and that matters for text quality.
   `both` also holds the TO-state after the animation ends, which leaves
   `transform: translate3d(0,0,0)` permanently on the element — a no-op
   visually, but enough to keep it promoted to its own compositor layer for
   the rest of the session. Text on a promoted layer loses subpixel
   antialiasing, and the hero h1 is a large, thin-stroked serif filled with a
   `background-clip: text` gradient, which is exactly the combination that
   turns soft. `backwards` still holds the from-state through the delay, so
   nothing flashes in early; it just lets the element settle back to its
   natural, unpromoted state when it is done. Also frees ~10 permanent layers
   across the page. */
@keyframes enter-up {
  from {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}
.enter-up {
  animation: enter-up 360ms var(--ease-premium) backwards;
  animation-delay: var(--enter-delay, 0ms);
}

@keyframes enter-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.enter-fade {
  animation: enter-fade 360ms var(--ease-premium) backwards;
  animation-delay: var(--enter-delay, 0ms);
}

/* Card hover lift, previously framer's `whileHover={{ y: -6 }}`. Doing it in
   CSS also removes the conflict that had the browser re-interpolating framer's
   per-frame inline transform writes. */
.hover-lift {
  transition: transform 200ms var(--ease-premium);
}
@media (hover: hover) and (pointer: fine) {
  .hover-lift:hover {
    transform: translate3d(0, -6px, 0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .reveal,
  .reveal.is-visible {
    opacity: 1;
    transform: none;
    transition: none;
  }
  .enter-up,
  .enter-fade {
    animation: none;
  }
  .hover-lift {
    transition: none;
  }
  .hover-lift:hover {
    transform: none;
  }
}

/* Honour the OS-level reduced-motion setting. Transitions collapse to
   effectively instant rather than being removed outright, so state changes
   (accordion open, menu toggle) still complete and nothing gets stuck
   mid-animation. framer-motion is handled separately via MotionConfig. */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ===========================================================================
   HERO VISUAL — the building showcase in the hero's right column.
   Consumed by components/HeroVisual.tsx.

   WHY THE CONTINUOUS ANIMATIONS LIVE HERE AND NOT IN FRAMER-MOTION
   ----------------------------------------------------------------
   Everything in this block loops forever: the float, the orbit rings, the
   glow, the border sweep, the particles, the card idle drift. framer-motion
   drives infinite animations from a main-thread rAF loop, recomputing an
   eased value and writing a style string for every element every frame.
   A CSS keyframe animation on `transform`/`opacity` is handed to the
   compositor once and then costs the main thread literally nothing — it
   keeps running at 60fps even while React is hydrating or an image is
   decoding. With ~20 always-on animated nodes here that difference is the
   whole frame budget.

   So the split is deliberate:
     CSS    -> anything infinite, plus the container entrance
     framer -> mouse parallax, card stagger, hover  (see HeroVisual.tsx)

   The container entrance is CSS for a second reason: HeroVisual is loaded
   from a deferred chunk, and a framer `initial={{ opacity: 0 }}` would be
   server-rendered as a genuinely invisible hero until that chunk hydrates.
   A CSS entrance plays off the SSR'd markup, immediately, every time.

   EVERY rule below animates only `transform` and `opacity`. No width, no
   height, no top/left, no box-shadow interpolation, no filter interpolation
   — nothing that can trigger layout or paint on a frame.
=========================================================================== */

/* --- Entrance ------------------------------------------------------------
   Fade in, scale 0.9 -> 1, and rise. `both` holds the from-state through the
   delay so nothing flashes at full opacity before its turn. */
@keyframes hv-enter {
  from {
    opacity: 0;
    transform: translate3d(0, 24px, 0) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}
.hv-enter {
  animation: hv-enter 900ms var(--ease-premium) both;
  animation-delay: var(--hv-delay, 0ms);
}

/* Plain fade, for the rings and glow which must not re-scale (they carry
   their own transform). */
@keyframes hv-fade {
  from {
    opacity: 0;
  }
}
.hv-fade-in {
  animation: hv-fade 1200ms var(--ease-premium) both;
  animation-delay: var(--hv-delay, 0ms);
}

/* --- 1. Float ------------------------------------------------------------
   The whole showcase drifts. 7s is slow enough to read as "alive" rather
   than "animated". Travel is 14px: below ~8px the eye stops registering
   drift entirely (the same lesson as .logo-float above).

   This sits on its own element. A running keyframe animation overrides an
   element's own `transform` declaration, so the float cannot share a node
   with the framer parallax rotation — nested, the two transforms compose. */
@keyframes hv-float {
  0%,
  100% {
    transform: translate3d(0, 0, 0);
  }
  50% {
    transform: translate3d(0, -14px, 0);
  }
}
.hv-float {
  animation: hv-float 7s ease-in-out infinite;
  will-change: transform;
}

/* --- Volumetric light shafts --------------------------------------------
   What replaced the rotating radar. Three soft, wide beams raking down across
   the panel at a slight angle, each breathing on its own clock at its own
   phase so they never pulse together and the light never reads as a loop.

   Nothing rotates and nothing is blurred: a beam is one linear gradient,
   painted once, then only its `opacity` and a small vertical `translate`
   change. Cost per frame is a compositor alpha change on an existing texture
   — cheaper than the ring it replaces, which had to spin a filtered SVG
   layer. Depth comes from the beams being at different widths, angles and
   speeds, not from motion. */
@keyframes hv-beam {
  0%,
  100% {
    opacity: 0.18;
    transform: translate3d(0, -3%, 0) scaleY(1);
  }
  50% {
    opacity: 0.5;
    transform: translate3d(0, 3%, 0) scaleY(1.06);
  }
}
.hv-beam {
  background: linear-gradient(
    to bottom,
    rgba(125, 211, 252, 0.34) 0%,
    rgba(56, 189, 248, 0.14) 42%,
    transparent 82%
  );
  animation: hv-beam var(--hv-beam-duration, 11s) ease-in-out infinite;
  animation-delay: var(--hv-beam-delay, 0s);
  will-change: transform, opacity;
}

/* --- Podium neon rim -----------------------------------------------------
   The blue edge light on the podium disc. Only `opacity` moves; the shadow
   itself is painted once onto a pseudo-element, because interpolating a
   box-shadow re-renders its blurred spread every frame. */
@keyframes hv-podium-pulse {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 1;
  }
}
.hv-podium-rim::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  box-shadow: 0 0 22px -2px rgba(56, 189, 248, 0.75),
    0 0 60px -10px rgba(37, 99, 235, 0.6);
  animation: hv-podium-pulse 6.5s ease-in-out infinite;
  pointer-events: none;
  will-change: opacity;
}

/* --- Illuminated podium branding ----------------------------------------
   The SRAJ plate. `text-shadow` is static — it is the glow itself, rasterised
   once with the text. Only the overlaid highlight's opacity breathes, so the
   lettering reads as physically lit rather than as an animated filter. */
@keyframes hv-brand-glow {
  0%,
  100% {
    opacity: 0.45;
  }
  50% {
    opacity: 0.9;
  }
}
.hv-brand {
  /* Emboss: a dark shadow below and a light catch above, so the letters read
     as raised out of the metal rather than printed onto it. */
  text-shadow: 0 1px 0 rgba(2, 6, 23, 0.95), 0 -1px 0 rgba(148, 197, 255, 0.28),
    0 0 12px rgba(56, 189, 248, 0.75), 0 0 26px rgba(37, 99, 235, 0.5);
}
.hv-brand-halo {
  animation: hv-brand-glow 6.5s ease-in-out infinite;
  will-change: opacity;
}

/* --- 3. Breathing glow ---------------------------------------------------
   A painted radial gradient whose opacity and scale breathe. Nothing is
   blurred: the gradient is soft by construction, so there is no filter to
   re-evaluate. Cheapest continuous effect a browser offers — it costs the
   same at 100px or 1000px across. */
@keyframes hv-glow-breathe {
  0%,
  100% {
    opacity: 0.34;
    transform: scale(0.94);
  }
  50% {
    opacity: 0.62;
    transform: scale(1.06);
  }
}
.hv-glow {
  background: radial-gradient(
    circle,
    rgba(56, 189, 248, 0.85) 0%,
    rgba(37, 99, 235, 0.5) 32%,
    rgba(30, 64, 175, 0.22) 58%,
    transparent 76%
  );
  animation: hv-glow-breathe 8s ease-in-out infinite;
  will-change: transform, opacity;
}

/* --- 4. Animated border sweep -------------------------------------------
   The classic moving-light border, done the cheap way.

   The obvious implementation animates `background-position` on a gradient
   border, which repaints the border box every single frame. This instead
   paints ONE conic gradient — a bright arc falling off into transparency —
   onto an oversized square behind the panel, and rotates it. Rotation is a
   compositor transform, so the sweep costs nothing per frame. The panel on
   top is inset by the border width, so only the 1.5px rim shows through.

   The square must be wider than the frame's diagonal, otherwise its corners
   sweep out of the frame and the light visibly disappears four times a turn.
   150% of the long edge covers it. */
@keyframes hv-sweep {
  from {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  to {
    transform: translate(-50%, -50%) rotate(360deg);
  }
}
.hv-sweep {
  background: conic-gradient(
    from 0deg,
    transparent 0deg,
    transparent 62deg,
    rgba(56, 189, 248, 0.16) 78deg,
    rgba(125, 211, 252, 0.95) 90deg,
    rgba(56, 189, 248, 0.16) 102deg,
    transparent 118deg,
    transparent 360deg
  );
  animation: hv-sweep 6s linear infinite;
  will-change: transform;
}

/* Border glow pulse. Sits on a pseudo-element so the shadow is painted once
   and only its `opacity` is animated — interpolating a box-shadow would
   re-render the blurred spread on every frame. */
@keyframes hv-rim-pulse {
  0%,
  100% {
    opacity: 0.35;
  }
  50% {
    opacity: 0.85;
  }
}
.hv-rim {
  position: relative;
}
.hv-rim::after {
  content: "";
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  box-shadow: 0 0 0 1px rgba(125, 211, 252, 0.28),
    0 0 34px -6px rgba(56, 189, 248, 0.55);
  animation: hv-rim-pulse 5s ease-in-out infinite;
  pointer-events: none;
  will-change: opacity;
}

/* --- 5. Particles --------------------------------------------------------
   Each particle drifts along its own vector and fades at both ends, so the
   loop's jump back to the origin happens at opacity 0 and is invisible. The
   per-particle vector, size, duration and delay come in as custom properties
   from a fixed seeded table in HeroVisual.tsx — fixed rather than
   Math.random() so server and client markup match and React does not
   re-render the field on hydration. */
@keyframes hv-particle {
  0% {
    opacity: 0;
    transform: translate3d(0, 0, 0) scale(0.4);
  }
  18% {
    opacity: var(--hv-p-peak, 0.75);
  }
  82% {
    opacity: var(--hv-p-peak, 0.75);
  }
  100% {
    opacity: 0;
    transform: translate3d(var(--hv-p-x, 0px), var(--hv-p-y, -60px), 0) scale(1);
  }
}
.hv-particle {
  background: radial-gradient(
    circle,
    rgba(186, 230, 253, 0.95) 0%,
    rgba(56, 189, 248, 0.55) 45%,
    transparent 72%
  );
  animation: hv-particle var(--hv-p-duration, 9s) linear infinite;
  animation-delay: var(--hv-p-delay, 0s);
  will-change: transform, opacity;
}

/* --- Animated ambient light ---------------------------------------------
   A large, very soft radial that drifts across the panel on a long cycle, so
   the glass never looks evenly lit. Pure translate + opacity; the gradient
   itself is painted once. */
@keyframes hv-ambient {
  0%,
  100% {
    opacity: 0.5;
    transform: translate3d(-14%, -8%, 0) scale(1);
  }
  50% {
    opacity: 0.9;
    transform: translate3d(14%, 8%, 0) scale(1.12);
  }
}
.hv-ambient {
  background: radial-gradient(
    circle at 50% 50%,
    rgba(125, 211, 252, 0.3) 0%,
    rgba(56, 189, 248, 0.14) 38%,
    transparent 68%
  );
  animation: hv-ambient 14s ease-in-out infinite;
  will-change: transform, opacity;
}

/* --- Glass sheen ---------------------------------------------------------
   The diagonal highlight that reads as light catching a pane. It travels on a
   long, mostly-idle cycle: a sheen that sweeps constantly reads as a loading
   skeleton, so it sits still for most of the loop and crosses quickly.

   The travel is expressed in multiples of the sheen's OWN width (45% of the
   panel), so -180% starts it fully off the left edge and 280% carries it
   fully off the right — it crosses the whole panel rather than being clipped
   to one side. */
@keyframes hv-sheen {
  0%,
  70% {
    opacity: 0;
    transform: translate3d(-180%, 0, 0) rotate(16deg) scale(1.4);
  }
  77% {
    opacity: 0.55;
  }
  93%,
  100% {
    opacity: 0;
    transform: translate3d(280%, 0, 0) rotate(16deg) scale(1.4);
  }
}
.hv-sheen {
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.09) 45%,
    rgba(255, 255, 255, 0.16) 50%,
    rgba(255, 255, 255, 0.09) 55%,
    transparent 100%
  );
  animation: hv-sheen 9s ease-in-out infinite;
  will-change: transform, opacity;
}

/* --- 7. Info card idle drift --------------------------------------------
   Each card breathes on its own clock so the four never sync up into a
   single pulsing block. Framer owns these cards' entrance and hover; this
   only owns the idle loop, and it lives on an inner wrapper so it never
   fights the transform framer writes on the outer node. */
@keyframes hv-card-drift {
  0%,
  100% {
    transform: translate3d(0, 0, 0);
  }
  50% {
    transform: translate3d(0, var(--hv-card-travel, -9px), 0);
  }
}
.hv-card-drift {
  animation: hv-card-drift var(--hv-card-duration, 6s) ease-in-out infinite;
  animation-delay: var(--hv-card-delay, 0s);
  will-change: transform;
}

/* --- Reduced motion ------------------------------------------------------
   The global rule above already collapses every animation to 0.01ms, which
   parks each of these at its end state. Two need explicit handling: the
   particles would park at opacity 0 (fine, but keep them out of the a11y
   tree and off the GPU), and every `will-change` above should be released
   since nothing is animating any more — a promoted layer that never changes
   is pure memory cost. */
@media (prefers-reduced-motion: reduce) {
  .hv-particle {
    display: none;
  }
  .hv-float,
  .hv-glow,
  .hv-sweep,
  .hv-rim::after,
  .hv-ambient,
  .hv-sheen,
  .hv-beam,
  .hv-podium-rim::after,
  .hv-brand-halo,
  .hv-card-drift {
    will-change: auto;
  }
  .hv-beam {
    opacity: 0.34;
    transform: none;
  }
  .hv-podium-rim::after,
  .hv-brand-halo {
    opacity: 0.75;
  }
  .hv-sheen {
    display: none;
  }
  .hv-ambient {
    opacity: 0.7;
    transform: none;
  }
  /* Park the glow and rim at the midpoint of their range rather than at an
     arbitrary keyframe end, so the composition still reads as designed. */
  .hv-glow {
    opacity: 0.48;
    transform: none;
  }
  .hv-rim::after {
    opacity: 0.6;
  }
}
